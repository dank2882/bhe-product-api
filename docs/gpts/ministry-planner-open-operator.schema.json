                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "appliedFilters": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
