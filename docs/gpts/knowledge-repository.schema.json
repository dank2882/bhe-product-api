{
  "openapi": "3.1.0",
  "info": {
    "title": "BHE Knowledge Repository API",
    "version": "1.0.0",
    "description": "API for ingesting repository documents, running repository OCR workflows, retrieving repository source text, organizing repository items, and linking evidence documents to knowledge items."
  },
  "servers": [
    {
      "url": "https://bhe-product-api-265001256563.us-west1.run.app"
    }
  ],
  "paths": {
    "/repository/documents/upload-openai-files": {
      "post": {
        "operationId": "uploadRepositoryDocuments",
        "summary": "Upload repository PDFs with provenance metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRepositoryDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository documents created"
          },
          "400": {
            "description": "Invalid upload request"
          }
        }
      }
    },
    "/repository/documents/search": {
      "post": {
        "operationId": "searchRepositoryDocuments",
        "summary": "Search repository documents by text with optional provenance filters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRepositoryDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching repository documents returned"
          },
          "400": {
            "description": "Invalid search request"
          }
        }
      }
    },
    "/repository/documents/by-provenance": {
      "post": {
        "operationId": "listRepositoryDocumentsByProvenance",
        "summary": "List repository documents by exact provenance fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRepositoryDocumentsByProvenanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching repository documents returned"
          },
          "400": {
            "description": "At least one provenance filter is required"
          }
        }
      }
    },
    "/repository/documents/{documentId}": {
      "get": {
        "operationId": "getRepositoryDocument",
        "summary": "Get a repository document by documentId",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository document found"
          },
          "404": {
            "description": "Repository document not found"
          }
        }
      }
    },
    "/repository/documents/{documentId}/provenance/save": {
      "post": {
        "operationId": "saveRepositoryDocumentProvenance",
        "summary": "Save provenance fields on an existing repository document",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRepositoryDocumentProvenanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository document provenance saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveRepositoryDocumentProvenanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "No valid provenance fields were provided"
          },
          "404": {
            "description": "Repository document not found"
          }
        }
      }
    },
    "/repository/documents/{documentId}/source-text": {
      "get": {
        "operationId": "getRepositoryDocumentSourceText",
        "summary": "Get the source-text package for a repository document",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository source text returned"
          },
          "404": {
            "description": "Repository document not found"
          }
        }
      }
    },
    "/repository/documents/{documentId}/ocr/start": {
      "post": {
        "operationId": "startRepositoryDocumentOcr",
        "summary": "Run OCR for a repository document",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository OCR completed"
          },
          "400": {
            "description": "Invalid OCR request"
          }
        }
      }
    },
    "/repository/documents/{documentId}/ocr/cleanup": {
      "post": {
        "operationId": "cleanupRepositoryDocumentOcr",
        "summary": "Clean repository OCR text",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository OCR cleanup completed"
          },
          "400": {
            "description": "No OCR text available to clean"
          }
        }
      }
    },
    "/repository/documents/{documentId}/ocr/normalize": {
      "post": {
        "operationId": "normalizeRepositoryDocumentOcr",
        "summary": "Normalize repository OCR text",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository OCR normalization completed"
          },
          "400": {
            "description": "No OCR text available to normalize"
          }
        }
      }
    },
    "/repository/documents/{documentId}/ocr/ai-correct": {
      "post": {
        "operationId": "aiCorrectRepositoryDocumentOcr",
        "summary": "AI-correct repository OCR text",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository OCR AI correction completed"
          },
          "400": {
            "description": "No OCR text available to AI-correct"
          }
        }
      }
    },
    "/repository/documents/{documentId}/ocr/human-review": {
      "post": {
        "operationId": "humanReviewRepositoryDocumentOcr",
        "summary": "Save human-reviewed OCR text for a repository document",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRepositoryHumanReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Human-reviewed repository OCR text saved"
          },
          "400": {
            "description": "Invalid human review request"
          }
        }
      }
    },
    "/repository/items": {
      "post": {
        "operationId": "createRepositoryItem",
        "summary": "Create a repository item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRepositoryItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository item created"
          },
          "400": {
            "description": "Invalid repository item request"
          }
        }
      }
    },
    "/repository/items/search": {
      "post": {
        "operationId": "searchRepositoryItems",
        "summary": "Search repository items by title, type, or summary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRepositoryItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching repository items returned"
          },
          "400": {
            "description": "Invalid search request"
          }
        }
      }
    },
    "/repository/items/{itemId}": {
      "get": {
        "operationId": "getRepositoryItem",
        "summary": "Get a repository item by itemId",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository item found"
          },
          "404": {
            "description": "Repository item not found"
          }
        }
      }
    },
    "/repository/items/{itemId}/summary/save": {
      "post": {
        "operationId": "saveRepositoryItemSummary",
        "summary": "Save a canonical summary on a repository item",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRepositoryItemSummaryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository item summary saved"
          },
          "400": {
            "description": "Invalid summary request"
          }
        }
      }
    },
    "/repository/items/{itemId}/link-documents": {
      "post": {
        "operationId": "linkRepositoryItemDocuments",
        "summary": "Link repository documents to a repository item",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkRepositoryItemDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repository documents linked to item"
          },
          "400": {
            "description": "Invalid linking request"
          }
        }
      }
    },
    "/repository/items/{itemId}/documents": {
      "get": {
        "operationId": "getRepositoryItemDocuments",
        "summary": "Get linked repository document summaries for an item",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Linked repository documents returned"
          },
          "404": {
            "description": "Repository item not found"
          }
        }
      }
    },
    "/debug/cloud-run-action-payload-inspect": {
      "post": {
        "operationId": "debugInspectCloudRunActionPayload",
        "summary": "Diagnostic only: inspect the raw GPT action payload for attached-file handoff",
        "description": "Temporary debug action. Use this only to inspect what the GPT action runtime sends to Cloud Run, especially whether attached PDFs arrive as backend-uploadable file references such as openaiFileIdRefs with download_link values. This is not part of the normal repository workflow.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DebugActionPayloadInspectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostic payload summary returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebugActionPayloadInspectionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadRepositoryDocumentsRequest": {
        "type": "object",
        "required": ["openaiFileIdRefs"],
        "properties": {
          "openaiFileIdRefs": {
            "type": "array",
            "description": "This parameter name must stay exactly openaiFileIdRefs so ChatGPT can pass conversation file uploads. At runtime the action may receive objects containing fields such as id, name, mime_type, and download_link. Repository document upload currently supports PDF files only.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            }
          },
          "originalFolderLabel": {
            "type": "string"
          },
          "binLabel": {
            "type": "string"
          },
          "scanBatchLabel": {
            "type": "string"
          },
          "sourceLocationNotes": {
            "type": "string"
          },
          "uploadedBy": {
            "type": "string"
          }
        }
      },
      "SearchRepositoryDocumentsRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          },
          "originalFolderLabel": {
            "type": "string"
          },
          "binLabel": {
            "type": "string"
          },
          "scanBatchLabel": {
            "type": "string"
          }
        }
      },
      "ListRepositoryDocumentsByProvenanceRequest": {
        "type": "object",
        "description": "At least one provenance field must be provided.",
        "anyOf": [
          {
            "required": ["originalFolderLabel"]
          },
          {
            "required": ["binLabel"]
          },
          {
            "required": ["scanBatchLabel"]
          }
        ],
        "properties": {
          "originalFolderLabel": {
            "type": "string"
          },
          "binLabel": {
            "type": "string"
          },
          "scanBatchLabel": {
            "type": "string"
          }
        }
      },
      "SaveRepositoryDocumentProvenanceRequest": {
        "type": "object",
        "description": "Partial provenance updates are allowed. The backend will reject requests if no valid provenance fields are provided.",
        "properties": {
          "originalFolderLabel": {
            "type": "string"
          },
          "binLabel": {
            "type": "string"
          },
          "scanBatchLabel": {
            "type": "string"
          },
          "sourceLocationNotes": {
            "type": "string"
          }
        }
      },
      "SaveRepositoryDocumentProvenanceResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SaveRepositoryHumanReviewRequest": {
        "type": "object",
        "required": ["humanReviewedText"],
        "properties": {
          "humanReviewedText": {
            "type": "string"
          }
        }
      },
      "CreateRepositoryItemRequest": {
        "type": "object",
        "required": ["title", "itemType"],
        "properties": {
          "title": {
            "type": "string"
          },
          "itemType": {
            "type": "string",
            "enum": [
              "person",
              "topic",
              "edition",
              "event",
              "place",
              "collection",
              "unsorted"
            ]
          }
        }
      },
      "SearchRepositoryItemsRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        }
      },
      "SaveRepositoryItemSummaryRequest": {
        "type": "object",
        "required": ["canonicalSummary"],
        "properties": {
          "canonicalSummary": {
            "type": "string"
          }
        }
      },
      "LinkRepositoryItemDocumentsRequest": {
        "type": "object",
        "required": ["documentIds"],
        "properties": {
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DebugActionPayloadInspectionRequest": {
        "type": "object",
        "description": "Broad diagnostic request body for temporary payload inspection. This intentionally accepts arbitrary JSON object keys so the GPT action runtime can pass through attached-file handoff fields without strict validation.",
        "additionalProperties": true,
        "properties": {
          "openaiFileIdRefs": {
            "type": "array",
            "description": "Optional expected file-handoff field to inspect when a PDF is attached in chat.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "DebugActionPayloadInspectionResponse": {
        "type": "object",
        "description": "Diagnostic summary of the raw request payload received by Cloud Run.",
        "additionalProperties": true,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "source": {
                "type": "string"
              },
              "receivedAt": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "contentType": {
                "type": "string"
              },
              "bodyRootType": {
                "type": "string"
              },
              "topLevelBodyKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "topLevelBodyValueTypes": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "openaiFileIdRefsPresent": {
                "type": "boolean"
              },
              "openaiFileIdRefsIsArray": {
                "type": "boolean"
              },
              "openaiFileIdRefsLength": {
                "type": "integer"
              },
              "firstElementType": {
                "type": "string"
              },
              "firstElementKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "firstElementPreview": {},
              "relevantHeaders": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
