    "/daily-review": {
      "post": {
        "operationId": "buildDailyReview",
        "summary": "Build a daily review from projects, tasks, calendar events, routines, and Sarah-requested items",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "today": {
                    "type": "string",
                    "description": "Optional YYYY-MM-DD override for testing"
                  },
                  "detailLevel": {
                    "type": "string",
                    "enum": [
                      "compact",
                      "full"
                    ],
                    "default": "compact",
                    "description": "Use compact for GPT daily reviews; full includes longer stored notes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Daily review returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getDailyReview",
