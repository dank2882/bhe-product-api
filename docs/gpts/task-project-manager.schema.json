      "post": {
        "operationId": "createCalendarEvent",
        "summary": "Create a calendar event or scheduled household/work item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "lifeArea": {
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "church",
                      "personal"
                    ],
                    "default": "home"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "scheduled",
                      "cancelled",
                      "done"
                    ],
                    "default": "scheduled"
                  },
                  "startDateTime": {
                    "type": "string",
                    "description": "ISO-8601 date/time, such as 2026-07-01T18:00:00-07:00"
                  },
                  "endDateTime": {
                    "type": "string",
                    "description": "Optional ISO-8601 date/time"
                  },
                  "allDay": {
                    "type": "boolean",
                    "default": false
                  },
                  "location": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "recurrence": {
                    "type": "string",
                    "enum": [
                      "none",
                      "daily",
                      "weekly",
                      "monthly",
                      "custom"
                    ],
                    "default": "none"
                  },
                  "recurrenceNotes": {
                    "type": "string"
                  },
                  "requestedBy": {
                    "type": "string",
                    "default": "Dan"
                  }
